{
  "name": "raizledger",
  "version": "0.1.0",
  "private": true,
  "description": "Pruebas Anchor y cliente de RaízLedger",
  "scripts": {
    "test": "mocha --require ts-node/register/transpile-only --timeout 240000 tests/*.ts",
    "test:interval": "BPF_OUT_DIR=$(pwd)/target/deploy cargo test -p raizledger --test intervalo -- --nocapture",
    "test:local": "anchor test",
    "build": "anchor build",
    "deploy:devnet": "anchor deploy --provider.cluster devnet"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.0",
    "@solana/web3.js": "^1.98.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "chai": "^4.5.0",
    "mocha": "^11.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
